# Local demo proxy keys. Copy to .env.local and fill in.
# In production, set these in Netlify (Project configuration → Environment variables),
# never in git. The browser never receives them.
DEMO_MISTRAL_API_KEY=
DEMO_GEMINI_API_KEY=

# Optional, stable salt for hashing visitor IPs before rate-limit counters are stored.
DEMO_IP_SALT=
