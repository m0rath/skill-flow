{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research.json - mitigation plan for every advisory of one product",
  "description": "vendors/<vendor>/<product>/research.json. Written by the research agent; the reviewer agent writes only 'review'. The collector never touches it.",
  "type": "object",
  "required": [
    "target",
    "updated_at",
    "advisories"
  ],
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$"
    },
    "updated_at": {
      "type": "string"
    },
    "advisories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/advisory"
      }
    },
    "not_mitigatable": {
      "type": "object",
      "description": "Derived list, regenerated every run: advisory_id -> reason.",
      "additionalProperties": {
        "$ref": "#/$defs/not_mitigatable_reason"
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "very_high",
        "high",
        "medium",
        "low",
        "very_low",
        "none"
      ]
    },
    "not_mitigatable_reason": {
      "enum": [
        "VULNERABLE_CODE_ALWAYS_REACHABLE",
        "NO_CONFIG_CONTROL",
        "NO_ACTIONITEM_FOUND",
        "ALL_CANDIDATES_FAILED",
        "CLI_UNAVAILABLE"
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "mode",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1,
          "description": "Mode the command runs in, as the vendor names it."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "May contain ${VAR} (from backup) or <SITE_VALUE>."
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "mode",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Read-only command."
        },
        "vulnerable_if": {
          "type": "string",
          "description": "Regex on the output: a match means the device is vulnerable."
        },
        "already_mitigated_if": {
          "type": "string",
          "description": "Regex on the output: a match means this mitigation is already in place."
        },
        "applies_to": {
          "type": "string",
          "description": "vulnerable_check only, optional: the release train(s) this check is valid for, when the check's syntax differs by train. Omitted = every affected train."
        }
      }
    },
    "backup": {
      "type": "object",
      "required": [
        "mode",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "minProperties": 0,
          "description": "NAME -> regex with one capture group. Each matching output line's group is saved. A step whose whole command is ${NAME} re-enters every saved value in order; a step with ${NAME} inside a longer command is repeated once per saved value, with the value substituted. An empty variable skips its rollback step. Omit variables only for a setup step (e.g. PAN-OS 'set cli config-output-format set') that makes later backup output replayable.",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mitigation": {
      "type": "object",
      "required": [
        "applies_to",
        "precondition",
        "mitigate",
        "rollback",
        "priority",
        "vendor_mentioned",
        "confidence",
        "reasoning",
        "impact",
        "impact_confidence",
        "disablement_safety",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "applies_to": {
          "type": "string",
          "description": "Release train(s) this command syntax is documented for."
        },
        "cves": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CVE-\\d{4}-\\d{4,}$"
          },
          "description": "Only when it covers some, not all, of the advisory's CVEs."
        },
        "precondition": {
          "description": "Already-mitigated check: one check, or a list of checks that must ALL match (for a plan that changes several tables or paths).",
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/check"
                }
              ],
              "required": [
                "already_mitigated_if"
              ],
              "description": "Run before mitigating: already mitigated -> skip. Run again after: confirms it took effect."
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/check"
                  }
                ],
                "required": [
                  "already_mitigated_if"
                ],
                "description": "Run before mitigating: already mitigated -> skip. Run again after: confirms it took effect."
              }
            }
          ]
        },
        "mitigate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Every step in order, including entering modes and saving."
        },
        "rollback": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Every step in order; restores the backup via ${VAR}."
        },
        "site_values": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^<[A-Z0-9_]+>$"
          },
          "description": "Values the site must supply for mitigate. Avoided when possible."
        },
        "priority": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "description": "High = the one to use."
        },
        "vendor_mentioned": {
          "type": "boolean",
          "description": "The vendor itself proposes this mitigation."
        },
        "confidence": {
          "$ref": "#/$defs/level"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "description": "One or two sentences: why this blocks the vulnerability."
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "description": "What stops working."
        },
        "impact_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "disablement_safety": {
          "$ref": "#/$defs/disablement_safety"
        },
        "evidence": {
          "type": "object",
          "required": [
            "why",
            "how"
          ],
          "additionalProperties": false,
          "description": "Proof for this mitigation, split by the question it answers.",
          "properties": {
            "why": {
              "$ref": "#/$defs/evidence_list",
              "description": "Why this command for this vulnerability: the vendor links the setting to the vulnerable component or says the change prevents exploitation."
            },
            "how": {
              "$ref": "#/$defs/how_list",
              "description": "How to apply it: the command's syntax, the mode it runs in, how to enter that mode, how to save."
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "round",
        "comments"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "open",
            "addressed",
            "accepted"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "resolved"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "resolved": {
                "type": "boolean"
              },
              "response": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "advisory": {
      "type": "object",
      "required": [
        "fp",
        "cves",
        "status",
        "research_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "fp": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Fingerprint of the advisory record; a change triggers re-research."
        },
        "saved_at": {
          "type": "string",
          "description": "UTC time this entry was last saved (set by scripts/research_tool.py merge). Evidence reused from another entry without re-fetching must come from one saved within 180 days."
        },
        "cves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "MITIGATED",
            "RESEARCH_REQUIRED",
            "NOT_MITIGATABLE"
          ]
        },
        "triage": {
          "$ref": "#/$defs/triage",
          "description": "Required on every entry saved from mitigation-research 1.12 on (enforced by scripts/research_tool.py); older entries without it are re-queued."
        },
        "not_mitigatable_reason": {
          "$ref": "#/$defs/not_mitigatable_reason"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vulnerable_check": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/check"
              }
            ],
            "required": [
              "vulnerable_if"
            ]
          },
          "description": "Vulnerable when any check matches, or when all match if vulnerable_when is 'all'."
        },
        "vulnerable_when": {
          "enum": [
            "any",
            "all"
          ],
          "description": "How the vulnerable_check entries combine: 'any' (default when absent) = vulnerable when any check matches (vuln_or); 'all' = only when every check matches (vuln_and), for exposure that needs several conditions shown by different commands."
        },
        "backup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backup"
          }
        },
        "mitigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mitigation"
          }
        },
        "knowledge_used": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+#[BP][0-9]{2}$"
          },
          "description": "Knowledge entries (knowledge/mitigations/<file>.md, e.g. fortinet_fortios#P01) this research relied on. scripts/research_tool.py logs each one to knowledge/usage.log on save."
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "evidence": {
          "type": "object",
          "required": [
            "exposure"
          ],
          "additionalProperties": false,
          "description": "Proof for the advisory-level checks.",
          "properties": {
            "exposure": {
              "$ref": "#/$defs/exposure_list",
              "description": "Why vulnerable_check and backup detect the vulnerable configuration."
            }
          }
        },
        "disablement_safety": {
          "$ref": "#/$defs/disablement_safety",
          "description": "NOT_MITIGATABLE only: the vulnerable component's tier (NON-DISABLABLE when it cannot be turned off)."
        },
        "research_notes": {
          "type": "object",
          "required": [
            "root_cause",
            "attack_path",
            "conclusion"
          ],
          "additionalProperties": false,
          "description": "Why research reached this status, in plain words.",
          "properties": {
            "root_cause": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "attack_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "conclusion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Why this status and this High mitigation; what the alternatives lack; what is still open."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "MITIGATED"
              }
            }
          },
          "then": {
            "required": [
              "vulnerable_check",
              "backup",
              "mitigation",
              "evidence"
            ],
            "properties": {
              "vulnerable_check": {
                "minItems": 1
              },
              "backup": {
                "minItems": 1
              },
              "mitigation": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_MITIGATABLE"
              }
            }
          },
          "then": {
            "required": [
              "not_mitigatable_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "RESEARCH_REQUIRED"
              }
            }
          },
          "then": {
            "required": [
              "open_questions"
            ],
            "properties": {
              "open_questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_MITIGATABLE"
              },
              "not_mitigatable_reason": {
                "enum": [
                  "VULNERABLE_CODE_ALWAYS_REACHABLE",
                  "NO_CONFIG_CONTROL"
                ]
              }
            },
            "required": [
              "not_mitigatable_reason"
            ]
          },
          "then": {
            "required": [
              "disablement_safety"
            ],
            "properties": {
              "disablement_safety": {
                "properties": {
                  "tier": {
                    "const": "NON-DISABLABLE"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "urls",
        "quotes"
      ],
      "additionalProperties": false,
      "description": "Quotes backing the advisory's plan. Each quote appears once in the whole advisory; pages that carry the identical quotes are listed together in 'urls'.",
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "maxItems": 4
        }
      }
    },
    "disablement_safety": {
      "type": "object",
      "required": [
        "tier",
        "reason"
      ],
      "additionalProperties": false,
      "description": "How safe it is to disable/change what the mitigation (or, for NOT_MITIGATABLE, the vulnerable component) touches.",
      "properties": {
        "tier": {
          "enum": [
            "SAFE",
            "SAFE-CONDITIONAL",
            "DISRUPTIVE",
            "NON-DISABLABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this tier, in one or two sentences, based on the evidence."
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "description": "What must be true (and how to check it) before acting. Required for SAFE-CONDITIONAL; optional for DISRUPTIVE (e.g. per-object or single-VDOM scope limits)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": "SAFE-CONDITIONAL"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ]
          }
        }
      ]
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "triage": {
      "type": "object",
      "required": [
        "class",
        "basis",
        "hidden_mitigation_hint",
        "initial_confidence"
      ],
      "additionalProperties": false,
      "description": "The workaround-triage result this research started from (workaround-triage skill). Kept for the reviewer; the final confidence is on each mitigation.",
      "properties": {
        "class": {
          "enum": [
            "COMMAND_PROVIDED",
            "UI_PATH_PROVIDED",
            "EVIDENCE_REQUIRED",
            "NON_ACTIONABLE",
            "NO_WORKAROUND",
            "ABSENT",
            "UNKNOWN"
          ]
        },
        "basis": {
          "type": "string",
          "description": "The exact vendor sentence(s) the class rests on, prefixed with the field they came from when it is not `workaround` (e.g. 'solution: ...'); 'workaround field is null' for ABSENT."
        },
        "hidden_mitigation_hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "The strongest mitigation-like quote from solution, details, required_configuration or exploitation_status, with its field name; null when none."
        },
        "initial_confidence": {
          "$ref": "#/$defs/level"
        }
      }
    },
    "exposure_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "description": "Like evidence_list, but up to 4 entries: 3 for any status (the advisory plus pages for checks run with different commands), 4 for NOT_MITIGATABLE, which must prove every attack path stays open."
    },
    "how_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "description": "evidence.how: up to 6 entries, because syntax, mode entry, the save step and a multi-object plan's add/rm/unbind pages (e.g. NetScaler SAML objects) often come from different pages."
    }
  }
}
