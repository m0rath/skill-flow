{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw advisory record",
  "description": "The value stored under each advisory_id key in advisories.json. Validate every record against this with jsonschema before storing (and during --dry-run).",
  "type": "object",
  "required": [
    "advisory_id",
    "cve_ids",
    "summary",
    "version_affected",
    "workaround",
    "additional_details"
  ],
  "properties": {
    "advisory_id": {
      "type": "string",
      "minLength": 1
    },
    "cve_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CVE-\\d{4}-\\d{4,}$"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "version_affected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product",
          "kind",
          "raw"
        ],
        "additionalProperties": false,
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "exact",
              "range",
              "branch",
              "all"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "from_inclusive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_inclusive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "raw": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "exact",
                    "branch"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "version"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "range"
                }
              }
            },
            "then": {
              "required": [
                "from",
                "to"
              ],
              "anyOf": [
                {
                  "properties": {
                    "from": {
                      "type": "string"
                    }
                  }
                },
                {
                  "properties": {
                    "to": {
                      "type": "string"
                    }
                  }
                }
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "from": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "from"
                    ]
                  },
                  "then": {
                    "required": [
                      "from_inclusive"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "to": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "to"
                    ]
                  },
                  "then": {
                    "required": [
                      "to_inclusive"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "workaround": {
      "type": [
        "string",
        "null"
      ]
    },
    "additional_details": {
      "type": "object",
      "properties": {
        "date_published": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "First published, via the study's full fallback chain."
        },
        "cwe_capec_mitre": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ],
          "description": "CWE / CAPEC / MITRE or other classification; may list several."
        },
        "security_details": {
          "type": "string",
          "description": "Solution, fixed software, required configuration, exploitation status, technical details - verbatim, line breaks kept. Hidden mitigations live here."
        },
        "bug_details": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "impact": {
          "type": "string"
        },
        "discovered": {
          "type": "string"
        },
        "attack_type": {
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Only the advisory-script-builder step 6 keys; absent when the vendor does not carry them. Never an empty string."
    }
  },
  "additionalProperties": false
}
